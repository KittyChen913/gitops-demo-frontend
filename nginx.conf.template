server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # 提供靜態 SPA
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 將 API 請求代理至後端服務。
    # BACKEND_URL 會在容器啟動時透過 envsubst 注入，實際 endpoint 由 deployment owner 提供。
    location /version {
        proxy_pass         http://${BACKEND_URL}/version;
        include            /etc/nginx/proxy_params;
    }

    location /health {
        proxy_pass         http://${BACKEND_URL}/health;
        include            /etc/nginx/proxy_params;
    }

    location /meta {
        proxy_pass         http://${BACKEND_URL}/meta;
        include            /etc/nginx/proxy_params;
    }
}
